---
import type { Lang } from '../i18n/config';
import { formatDate, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  href: string;
  title: string;
  description: string;
  date?: Date;
  draft?: boolean;
  kicker?: string;
  /** Niveau du titre : 2 sur une page de rubrique (sous le h1), 3 sous un h2 (accueil). */
  level?: 2 | 3;
}
const { lang, href, title, description, date, draft, kicker, level = 3 } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
const t = useTranslations(lang);
---

<li class="entry-card">
  <article>
    <div class="meta">
      {kicker && <span class="kicker">{kicker}</span>}
      {draft && <span class="badge badge--draft">{t('common.draft')}</span>}
    </div>
    <H class="entry-title"><a href={href}>{title}</a></H>
    <p>{description}</p>
    {date && <time class="muted" datetime={date.toISOString()}>{formatDate(date, lang)}</time>}
  </article>
</li>

<style>
  .entry-card article {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    box-shadow: var(--shadow);
    transition: border-color 0.15s;
  }
  .entry-card article:hover,
  .entry-card article:focus-within {
    border-color: var(--color-primary);
  }
  .meta {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    min-height: 1.2rem;
  }
  .kicker {
    font-size: 0.75rem;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }
  :global(:root[lang='ar']) .kicker {
    text-transform: none;
    letter-spacing: 0;
  }
  .entry-title {
    margin: 0;
    font-size: var(--fs-lg);
  }
  .entry-title a {
    color: var(--color-text);
    text-decoration: none;
  }
  /* Toute la carte est cliquable */
  .entry-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    flex: 1;
  }
  time {
    font-size: 0.8rem;
  }
</style>
