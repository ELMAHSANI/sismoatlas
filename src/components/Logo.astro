---
/** Logo provisoire : un tracé de sismogramme dans un cercle. Le logo définitif ira dans public/. */
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <circle cx="16" cy="16" r="15" fill="var(--color-primary)"></circle>
  <path
    d="M4 16h5l2-4 3 10 3-15 3 13 2-4h6"
    fill="none"
    stroke="var(--color-on-primary)"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="17" cy="7" r="2.2" fill="var(--color-accent)"></circle>
</svg>
