---
import { LANGS, LANG_META, type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  altPaths: Record<Lang, string>;
}
const { lang, altPaths } = Astro.props;
const t = useTranslations(lang);
---

<nav class="lang-switcher" aria-label={t('a11y.langSwitcher')}>
  <ul>
    {
      LANGS.map((l) => (
        <li>
          <a
            href={altPaths[l]}
            hreflang={l}
            lang={l}
            title={LANG_META[l].label}
            aria-current={l === lang ? 'true' : undefined}
          >
            <span aria-hidden="true">{LANG_META[l].short}</span>
            <span class="visually-hidden">{LANG_META[l].label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 2px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }
  a {
    display: inline-grid;
    place-items: center;
    min-width: 2.25rem;
    height: 2.15rem;
    padding-inline: var(--space-2);
    border-radius: 4px;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--color-text);
  }
  a[aria-current='true'] {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  /* Pas de police arabe web ici : sur les pages FR/EN, on évite de télécharger la police
     arabe juste pour ce lien (la police système suffit). */
  a[lang='ar'] {
    font-family: Tahoma, 'Segoe UI', system-ui, sans-serif;
  }
</style>
