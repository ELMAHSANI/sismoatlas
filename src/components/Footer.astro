---
import Logo from './Logo.astro';
import { FOOTER_NAV, type Lang } from '../i18n/config';
import { routePath, useTranslations } from '../i18n/utils';
import { DATA_SOURCES } from '../data/sources';
import { SITE } from '../site.config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p class="disclaimer" role="note">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle><path d="M12 8v5M12 16.5v.5"></path>
      </svg>
      <span>{t('footer.disclaimer')}</span>
      <a href={routePath(lang, 'disclaimer')}>{t('nav.disclaimer')}</a>
    </p>

    <div class="footer-grid">
      <div>
        <a class="brand" href={routePath(lang, 'home')} aria-label={t('a11y.home')}>
          <Logo size={24} /><span>{t('site.name')}</span>
        </a>
        <p class="muted">{t('site.tagline')}</p>
      </div>

      <section aria-labelledby="footer-sources">
        <h2 id="footer-sources">{t('footer.sourcesTitle')}</h2>
        <p class="muted">{t('footer.sourcesIntro')}</p>
        <ul class="inline-list">
          {
            DATA_SOURCES.map((s) => (
              <li>
                <a href={s.url} rel="noopener" lang="en">{s.name}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <nav aria-label={t('a11y.footerNav')}>
        <ul class="footer-links">
          {
            FOOTER_NAV.map((key) => (
              <li>
                <a href={routePath(lang, key)}>{t(`nav.${key}`)}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="legal muted">
      <span>{t('footer.copyright', { year })}</span>
      <span>·</span>
      <span>{t('footer.contentLicense', { license: SITE.contentLicense })}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-8);
    padding-block: var(--space-6) var(--space-5);
    background: var(--color-surface);
    border-block-start: 1px solid var(--color-border);
    font-size: var(--fs-sm);
  }
  .disclaimer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    margin-block-end: var(--space-6);
    border-radius: var(--radius);
    background: var(--color-surface-2);
    font-weight: 500;
  }
  .disclaimer svg {
    color: var(--color-accent);
    flex: none;
  }
  .footer-grid {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 48rem) {
    .footer-grid {
      grid-template-columns: 1.2fr 1.5fr 1fr;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    margin-block-end: var(--space-2);
  }
  h2 {
    font-size: var(--fs-base);
    margin-block: 0 var(--space-2);
  }
  .inline-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    padding: 0;
  }
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-links li + li {
    margin-block-start: var(--space-2);
  }
  .footer-links a {
    color: var(--color-text);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
  }
</style>
