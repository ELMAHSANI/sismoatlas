---
/**
 * Accueil. Sections (CLAUDE.md §5) :
 *  1. Séismes au Maroc (phase 4)   2. Grands séismes dans le monde (phase 5)   3. Derniers articles et rapports
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import MagnitudeScale from '../../components/MagnitudeScale.astro';
import EntryCard from '../../components/EntryCard.astro';
import type { Lang } from '../../i18n/config';
import { langStaticPaths, routePath, useTranslations, type UIKey } from '../../i18n/utils';
import { entrySlug, getByLang, type ArticleCollection } from '../../lib/content';
import { SECTIONS } from '../../lib/sections';

export const getStaticPaths = langStaticPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const liveTabs: UIKey[] = ['home.live.tab.live', 'home.live.tab.24h', 'home.live.tab.7d', 'home.live.tab.30d'];
const worldTabs: UIKey[] = ['home.world.tab.7d', 'home.world.tab.30d', 'home.world.tab.1y'];

// Derniers contenus, toutes rubriques éditoriales confondues.
const latestFrom: ArticleCollection[] = ['reports', 'articles', 'earthquakes', 'understand', 'factchecks'];
const latest = (
  await Promise.all(latestFrom.map(async (c) => (await getByLang(c, lang)).map((entry) => ({ entry, collection: c }))))
)
  .flat()
  .sort((a, b) => b.entry.data.date.getTime() - a.entry.data.date.getTime())
  .slice(0, 6);
---

<BaseLayout lang={lang}>
  <section class="home-live" aria-labelledby="live-title">
    <div class="container">
      <h1 id="live-title">{t('home.live.title')}</h1>
      <p class="lead">{t('home.live.intro')}</p>
      <div class="tabs" role="presentation">
        {liveTabs.map((key, i) => <span class:list={['tab', { active: i === 0 }]}>{t(key)}</span>)}
      </div>
      <div class="live-grid">
        <div class="placeholder live-map">{t('common.placeholder')}</div>
        <MagnitudeScale lang={lang} />
      </div>
      <p class="muted live-note">{t('footer.disclaimer')}</p>
    </div>
  </section>

  <section class="container home-section" aria-labelledby="world-title">
    <h2 id="world-title">{t('home.world.title')}</h2>
    <p class="muted">{t('home.world.intro')}</p>
    <div class="tabs" role="presentation">
      {worldTabs.map((key, i) => <span class:list={['tab', { active: i === 0 }]}>{t(key)}</span>)}
    </div>
    <div class="placeholder">{t('common.placeholder')}</div>
  </section>

  <section class="container home-section" aria-labelledby="latest-title">
    <h2 id="latest-title">{t('home.latest.title')}</h2>
    {
      latest.length ? (
        <ul class="card-grid">
          {latest.map(({ entry, collection }) => (
            <EntryCard
              lang={lang}
              href={routePath(lang, SECTIONS[collection].route, entrySlug(entry))}
              title={entry.data.title}
              description={entry.data.description}
              date={entry.data.date}
              draft={entry.data.draft}
              kicker={t(`nav.${SECTIONS[collection].route}`)}
            />
          ))}
        </ul>
      ) : (
        <p class="placeholder">{t('common.emptyList')}</p>
      )
    }
    <p><a href={routePath(lang, 'articles')}>{t('home.latest.seeAll')} <span class="flip-rtl" aria-hidden="true">→</span></a></p>
  </section>
</BaseLayout>

<style>
  .home-live {
    padding-block: var(--space-6);
    background:
      radial-gradient(60rem 20rem at 85% -10%, color-mix(in srgb, var(--color-primary) 14%, transparent), transparent),
      var(--color-surface);
    border-block-end: 1px solid var(--color-border);
  }
  :global([dir='rtl']) .home-live {
    background:
      radial-gradient(60rem 20rem at 15% -10%, color-mix(in srgb, var(--color-primary) 14%, transparent), transparent),
      var(--color-surface);
  }
  .home-live h1 {
    margin-block-end: var(--space-2);
  }
  .lead {
    font-size: var(--fs-lg);
    color: var(--color-text-muted);
    max-width: var(--container-text);
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block: var(--space-4);
  }
  .tab {
    padding: var(--space-1) var(--space-4);
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .tab.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .live-grid {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 64rem) {
    .live-grid {
      grid-template-columns: 1fr 20rem;
      align-items: start;
    }
  }
  .live-map {
    min-height: 18rem;
    display: grid;
    place-items: center;
    background: var(--color-bg);
  }
  .live-note {
    margin: var(--space-4) 0 0;
    font-size: var(--fs-sm);
  }
  .home-section {
    padding-block-start: var(--space-2);
  }
  .home-section h2 {
    margin-block-end: var(--space-2);
  }
</style>
