---
import '@fontsource-variable/inter';
import '@fontsource-variable/noto-sans-arabic';
// Police principale de la langue préchargée : évite que le texte se décale quand elle arrive (CLS)
import interLatinUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import notoArabicUrl from '@fontsource-variable/noto-sans-arabic/files/noto-sans-arabic-arabic-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LANGS, LANG_META, DEFAULT_LANG, type Lang } from '../i18n/config';
import { switchLangPath, useTranslations } from '../i18n/utils';
import { SITE } from '../site.config';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Chemin de la page dans chaque langue (sinon : même chemin, langue remplacée). */
  alternates?: Partial<Record<Lang, string>>;
  noindex?: boolean;
  /** Partage sur les réseaux : « website » (défaut) ou « article » (avec dates). */
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Image de partage (chemin public) ; par défaut l'image SismoAtlas de la langue. */
  image?: string;
  /** Page qui lit les données en direct (accueil) : ouvrir la connexion à l'avance. */
  liveData?: boolean;
  /** Auteur d'un article (données structurées) ; « SismoAtlas » = le site lui-même. */
  author?: string;
  /** Mots-clés d'un article (étiquettes du frontmatter). */
  keywords?: string[];
}

const { lang, title, description, alternates, noindex = false, ogType = 'website', publishedTime, modifiedTime, image, liveData = false, author, keywords } = Astro.props;
// Origine des données en direct (GitHub Pages) : préconnexion pour gagner ~0,3 s sur mobile
const liveDataOrigin = (() => {
  try {
    return import.meta.env.PUBLIC_LIVE_DATA_URL ? new URL(import.meta.env.PUBLIC_LIVE_DATA_URL).origin : null;
  } catch {
    return null;
  }
})();
const t = useTranslations(lang);
const meta = LANG_META[lang];
const siteName = t('site.name');
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · ${t('site.tagline')}`;
const pageDescription = description ?? t('site.description');

const pathname = Astro.url.pathname;
const altPaths = Object.fromEntries(
  LANGS.map((l) => [l, alternates?.[l] ?? switchLangPath(pathname, l)]),
) as Record<Lang, string>;
// Les liens hreflang ne pointent que vers des traductions réellement disponibles.
const hreflangLangs = alternates ? LANGS.filter((l) => alternates[l]) : LANGS;
const canonical = new URL(pathname, Astro.site);
const ogImage = new URL(image ?? `/og/sismoatlas-${lang}.png`, Astro.site);
// Statistiques sans cookies (Cloudflare Web Analytics) : jeton fourni par Cloudflare, en production seulement
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined;
// Validation du site dans Google Search Console et Bing Webmaster Tools (jetons publics, variables Cloudflare)
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION as string | undefined;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION as string | undefined;
// Données structurées (schema.org) : le site et son éditeur sur l'accueil, l'article sur les pages de contenu
const isHome = pathname === `/${lang}/`;
const orgId = new URL('/#organization', Astro.site).href;
const organization = {
  '@type': 'Organization',
  '@id': orgId,
  name: siteName,
  url: new URL(`/${lang}/`, Astro.site).href,
  logo: new URL('/icons/icon-512.png', Astro.site).href,
  email: SITE.contactEmail,
};
const jsonLd = noindex
  ? null
  : isHome
    ? {
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            name: siteName,
            url: new URL(`/${lang}/`, Astro.site).href,
            inLanguage: meta.htmlLang,
            description: pageDescription,
            publisher: { '@id': orgId },
          },
          organization,
        ],
      }
    : ogType === 'article'
      ? {
          '@context': 'https://schema.org',
          '@type': 'Article',
          headline: title ?? siteName,
          description: pageDescription,
          inLanguage: meta.htmlLang,
          mainEntityOfPage: canonical.href,
          image: ogImage.href,
          ...(publishedTime && { datePublished: publishedTime.toISOString() }),
          ...((modifiedTime ?? publishedTime) && { dateModified: (modifiedTime ?? publishedTime)!.toISOString() }),
          author: author && author !== siteName ? { '@type': 'Person', name: author } : { '@id': orgId },
          publisher: organization,
          license: SITE.contentLicenseUrl,
          ...(keywords?.length && { keywords: keywords.join(', ') }),
        }
      : null;
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {hreflangLangs.map((l) => <link rel="alternate" hreflang={l} href={new URL(altPaths[l], Astro.site)} />)}
    {!alternates && <link rel="alternate" hreflang="x-default" href={new URL(altPaths[DEFAULT_LANG], Astro.site)} />}
    {noindex && <meta name="robots" content="noindex" />}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <link rel="preload" as="font" type="font/woff2" href={lang === 'ar' ? notoArabicUrl : interLatinUrl} crossorigin="anonymous" />
    {liveData && liveDataOrigin && <link rel="preconnect" href={liveDataOrigin} crossorigin="anonymous" />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={meta.ogLocale} />
    {hreflangLangs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LANG_META[l].ogLocale} />)}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — ${t('site.tagline')}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? siteName} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {
      import.meta.env.PROD && beaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beaconToken })}
        />
      )
    }
    <meta name="theme-color" content="#0b3d91" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a1120" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    {
      import.meta.env.PROD && (
        <script is:inline>
          // PWA : le guide de sécurité reste consultable hors ligne (public/sw.js)
          if ('serviceWorker' in navigator) {
            addEventListener('load', function () {
              navigator.serviceWorker.register('/sw.js').catch(function () {});
            });
          }
        </script>
      )
    }
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Avant l'affichage : thème choisi + suppression de la classe no-js.
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{t('a11y.skipToContent')}</a>
    <Header lang={lang} altPaths={altPaths} />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
