# Copier en .env pour un réglage local (ce fichier .env n'est pas versionné).
# Adresse des données en direct mises à jour toutes les 15 min (GitHub Pages, voir docs/HEBERGEMENT.md).
# Vide = le site lit la copie incluse dans son déploiement (/data/…).
PUBLIC_LIVE_DATA_URL=

# Statistiques sans cookies : jeton « Web Analytics » fourni par Cloudflare (facultatif).
PUBLIC_CF_BEACON_TOKEN=
# Référencement : jetons de validation (balises meta) de Google Search Console et Bing Webmaster Tools
# (facultatifs, publics ; voir docs/REFERENCEMENT.md).
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
# Adresse publique du site (sitemap, liens canoniques, partage).
SITE_URL=https://sismoatlas.pages.dev
